# ============================================================
#  環境變數範本
# ------------------------------------------------------------
#  使用方式：複製此檔為 .env，再依自己的環境填值。
#      cp .env.example .env
#
#  .env 已被 .gitignore 排除，不會進版控 —— 請勿把真實金鑰寫進本檔。
#  未設定的項目會採用 settings.py 內的預設值（見括號說明）。
# ============================================================

# ── 資料庫（必填）────────────────────────────────────────────
# 本機已安裝兩套服務，擇一即可：
#     MySQL 8.0     -> 3306
#     MariaDB 10.6  -> 3307
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=shoppingapp
DB_PASSWORD=請填入你的資料庫密碼
DB_DATABASE=shoppingapp

# ── Flask（選填）────────────────────────────────────────────
# APP_PORT 預設 7775
APP_PORT=7775
# SESSION_KEY 正式環境務必改成隨機字串，勿沿用預設值
SESSION_KEY=請改成一段隨機字串

# ── 寄信（選填；未設定則寄信功能無法使用）──────────────────
# Gmail 需使用「應用程式密碼」，不是登入密碼。
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=應用程式密碼

# ── Minecraft RCON（選填；未設定則發貨功能無法使用）────────
# 預設 127.0.0.1 / 25575
MC_RCON_HOST=127.0.0.1
MC_RCON_PORT=25575
MC_RCON_PASSWORD=你的 RCON 密碼

# ── Cloudinary 圖片託管（選填；未設定則無法上傳圖片）───────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── 綠界 ECPay（選填）───────────────────────────────────────
# 不填會自動使用綠界官方公開的測試金鑰，可直接跑完整測試流程。
# 要用自己的測試商店再填這三個值。
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=

# ngrok 公開網址：只有在需要綠界 server-to-server callback 時才要設。
# 目前流程改為瀏覽器跳回即完成訂單，本機測試通常不需要。
NGROK_URL=
